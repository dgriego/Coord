{
  "name": "@coord/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:@electric-sql/pglite --external:postgres --external:hono --external:@hono/node-server --external:drizzle-orm --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "tsx src/main.ts",
    "seed": "tsx src/seed.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@hono/node-server": "^2.1.5",
    "@coord/shared": "*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
